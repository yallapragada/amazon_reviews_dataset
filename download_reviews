# Loop through each compressed file and process it one by one
for file in *.jsonl.gz; do
    echo "Decompressing $file..."
    
    # Decompress the file
    gunzip "$file"
    
    # Get the decompressed file name (without .gz)
    decompressed_file="${file%.gz}"
    
    # Move the decompressed file to the resources folder
    # mv "$decompressed_file" ../resources/
    
    # echo "$decompressed_file moved to ../resources/"
    
    # Check available disk space
    # df -h .
done

